<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_payment_info"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="My Payment Info"
            android:textSize="18sp"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="@color/text_primary" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BAGIAN 1: REKENING OWNER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informasi Rekening &amp; E-Wallet"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gunakan informasi di bawah ini untuk melakukan pembayaran pesanan Anda. Pastikan nama penerima sesuai."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginBottom="16dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="32dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- BCA -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="20dp"
                        android:layout_marginEnd="12dp"
                        android:elevation="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bank BCA" android:textColor="@color/lavender_dark" android:textSize="14sp" android:fontFamily="@font/poppins_bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1234567890" android:textColor="@color/text_primary" android:textSize="22sp" android:fontFamily="@font/fredoka_bold" android:layout_marginTop="4dp" android:textIsSelectable="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="a/n Nailz By Nutz" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/poppins_medium"/>
                    </LinearLayout>

                    <!-- Mandiri -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="20dp"
                        android:layout_marginEnd="12dp"
                        android:elevation="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bank Mandiri" android:textColor="@color/lavender_dark" android:textSize="14sp" android:fontFamily="@font/poppins_bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0987654321" android:textColor="@color/text_primary" android:textSize="22sp" android:fontFamily="@font/fredoka_bold" android:layout_marginTop="4dp" android:textIsSelectable="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="a/n Nailz By Nutz" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/poppins_medium"/>
                    </LinearLayout>

                    <!-- E-Wallet -->
                    <LinearLayout
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="20dp"
                        android:layout_marginEnd="12dp"
                        android:elevation="2dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GoPay / OVO / Dana" android:textColor="@color/lavender_dark" android:textSize="14sp" android:fontFamily="@font/poppins_bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0812-3456-7890" android:textColor="@color/text_primary" android:textSize="22sp" android:fontFamily="@font/fredoka_bold" android:layout_marginTop="4dp" android:textIsSelectable="true"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="a/n Nailz By Nutz" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="@font/poppins_medium"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- BAGIAN 2: DAFTAR TAGIHAN & RIWAYAT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tagihan &amp; Riwayat Pembayaran"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:id="@+id/payment_history_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="30dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>