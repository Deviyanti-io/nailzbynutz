<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_header_gel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_gel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Pilih Gel Polish"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_medium"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next_gel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="Proceed to Booking"
        android:textColor="@color/white"
        android:backgroundTint="@color/lavender_dark"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        app:cornerRadius="28dp"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_header_gel"
        android:layout_above="@id/btn_next_gel"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis Kutek (Polish Type)"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <LinearLayout android:id="@+id/type_regular" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/regular_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Regular" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_gel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/gel_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Gel Polish" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_matte" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/matte_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Matte" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_chrome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/chrome_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chrome" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_cateye" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/cat_eye_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Cat Eye" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_glitter" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/glitter_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Glitter" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_jelly" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/jelly_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Jelly" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>

                <LinearLayout android:id="@+id/type_magnetic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="10dp" android:gravity="center" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="65dp" android:layout_height="65dp" android:src="@drawable/magnetic_polish" android:scaleType="centerInside" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Magnetic" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>