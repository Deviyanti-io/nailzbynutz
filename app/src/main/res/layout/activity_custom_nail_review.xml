<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_review"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Customize your nails."
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/fredoka_bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:layout_above="@+id/layout_bottom_action"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <View android:layout_width="match_parent" android:layout_height="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Review Your Design" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/layout_review_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp"
                android:elevation="2dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nail Shape" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_shape" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nail Length" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_length" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Color Type &amp; Hex" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                    <View android:id="@+id/view_review_color_preview" android:layout_width="20dp" android:layout_height="20dp" android:background="@drawable/bg_circle_color" android:layout_marginEnd="10dp" android:elevation="1dp"/>
                    <TextView android:id="@+id/tv_review_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finishing Coat" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_finish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selected Add-ons" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_addons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="@font/poppins_medium" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nail Size Specification" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_size" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="14dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Special Custom Request Notes" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium"/>
                <TextView android:id="@+id/tv_review_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="-" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="@font/poppins_medium" android:layout_marginBottom="14dp"/>

                <!-- Container Foto yang Diupload -->
                <TextView android:id="@+id/tv_image_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reference Photo" android:textColor="@color/text_secondary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:visibility="gone"/>
                <ImageView
                    android:id="@+id/iv_review_image"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bagian Bawah: Total & Tombol (Dipisah) -->
    <LinearLayout
        android:id="@+id/layout_bottom_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Harga:"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/poppins_medium"
                android:layout_centerVertical="true"/>
            <TextView
                android:id="@+id/tv_review_grand_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Rp 0"
                android:textSize="20sp"
                android:textColor="@color/lavender_dark"
                android:fontFamily="@font/poppins_bold"/>
        </RelativeLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_to_booking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lanjut Booking"
            android:textColor="@color/white"
            android:backgroundTint="@color/lavender_dark"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_bold"
            app:cornerRadius="28dp"
            android:elevation="4dp" />
    </LinearLayout>
</RelativeLayout>