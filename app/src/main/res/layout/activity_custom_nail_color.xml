<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_color"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Customize your nails."
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/fredoka_bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:layout_above="@+id/btn_next_color"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <View android:layout_width="match_parent" android:layout_height="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Color Type" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_type_solid" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Solid" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    <Button android:id="@+id/btn_type_gradient" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Ombre" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    <Button android:id="@+id/btn_type_french" android:layout_width="wrap_content" android:layout_height="40dp" android:text="French Tip" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginEnd="8dp" android:paddingHorizontal="16dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    <Button android:id="@+id/btn_type_cateye" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Cat Eye" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:paddingHorizontal="16dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                </LinearLayout>
            </HorizontalScrollView>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/title_choose_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Choose Color"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/tv_selected_color_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignBottom="@id/title_choose_color"
                    android:text="Belum dipilih"
                    android:textColor="@color/lavender_dark"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins_medium"/>
            </RelativeLayout>

            <GridLayout
                android:id="@+id/color_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="7"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_marginBottom="24dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Finish" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="4" android:layout_marginBottom="24dp">
                <LinearLayout android:id="@+id/btn_finish_glossy" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginRight="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_card_rounded">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_finish_glossy"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glossy" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_finish_matte" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="3dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_card_rounded">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_finish_matte"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Matte" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_finish_chrome" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="3dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_card_rounded">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_finish_chrome"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chrome" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_finish_glitter" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginLeft="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_card_rounded">
                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_finish_glitter"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glitter" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nail Art Add-ons" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="10dp" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_charms"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Charms" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_charms" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_charms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_charms" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="10dp" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_pearls"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pearls" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_pearls" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_pearls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_pearls" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="10dp" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_rhinestone"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rhinestone" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_rhinestone" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_rhinestone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_rhinestone" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="10dp" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_flower"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3D Flower" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_flower" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_flower" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_flower" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:layout_marginEnd="10dp" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_stickers"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stickers" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_stickers" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_stickers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_stickers" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="90dp" android:layout_height="125dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_rounded">
                        <ImageView android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_addon_bow"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bow" android:textColor="@color/text_primary" android:textSize="11sp" android:fontFamily="@font/poppins_medium" android:layout_marginTop="6dp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
                            <TextView android:id="@+id/btn_min_bow" android:layout_width="22dp" android:layout_height="22dp" android:text="-" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/divider" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginEnd="8dp"/>
                            <TextView android:id="@+id/tv_qty_bow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                            <TextView android:id="@+id/btn_add_bow" android:layout_width="22dp" android:layout_height="22dp" android:text="+" android:gravity="center" android:background="@drawable/bg_circle_color" android:backgroundTint="@color/lavender_dark" android:textColor="@color/white" android:textStyle="bold" android:layout_marginStart="8dp"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout android:id="@+id/btn_upload_photo_container"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="30dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_card_rounded">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_filter" app:tint="@color/lavender_dark"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upload foto referensi kamu di sini +" android:textColor="@color/lavender_dark" android:textSize="13sp" android:layout_marginLeft="10dp" android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tv_upload_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/lavender_dark"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next_color"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="Next Step"
        android:textColor="@color/white"
        android:backgroundTint="@color/lavender_dark"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        app:cornerRadius="28dp"
        android:elevation="4dp" />

</RelativeLayout>