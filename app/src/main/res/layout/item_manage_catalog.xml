<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/background_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gambar Katalog -->
        <ImageView
            android:id="@+id/img_catalog"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Nama Katalog -->
            <TextView
                android:id="@+id/tv_catalog_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Desain"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Harga Katalog -->
            <TextView
                android:id="@+id/tv_catalog_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 80.000"
                android:textColor="@color/lavender_dark"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp"/>

            <!-- Tombol Edit & Hapus (Berdampingan) -->
            <LinearLayout
                android:id="@+id/layout_action_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/btn_edit_catalog"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:gravity="center"
                    android:textColor="@color/lavender_dark"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_bold"
                    android:background="@drawable/bg_card_rounded"
                    android:backgroundTint="#EEF0FA"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/btn_delete_catalog"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Hapus"
                    android:gravity="center"
                    android:textColor="#D6001C"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_bold"
                    android:background="@drawable/bg_card_rounded"
                    android:backgroundTint="#FCE8E6"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>