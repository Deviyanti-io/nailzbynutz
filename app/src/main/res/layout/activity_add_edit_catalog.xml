<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_add_edit"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
        <TextView
            android:id="@+id/tv_title_add_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Tambah Katalog Baru"
            android:textSize="18sp"
            android:fontFamily="@font/fredoka_bold"
            android:textColor="@color/text_primary" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:padding="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto Desain Kuku"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="12dp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_upload_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF0FA">

                <ImageView
                    android:id="@+id/iv_catalog_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:id="@+id/layout_upload_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/lavender_dark"
                        android:layout_marginBottom="8dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Klik untuk Upload Gambar"
                        android:textColor="@color/lavender_dark"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Desain"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/et_catalog_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_card_rounded"
                android:paddingHorizontal="16dp"
                android:hint="Contoh: Premium Pink Ombre"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:fontFamily="@font/poppins_medium"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Harga Dasar (Rp)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="8dp"/>
            <EditText
                android:id="@+id/et_catalog_price"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_card_rounded"
                android:paddingHorizontal="16dp"
                android:hint="Contoh: 85000"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:fontFamily="@font/poppins_medium"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_catalog"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Simpan Katalog"
                android:textColor="@color/white"
                android:backgroundTint="@color/lavender_dark"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                app:cornerRadius="28dp"
                android:elevation="4dp" />

        </LinearLayout>
    </ScrollView>
</RelativeLayout>