<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <RelativeLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">
        <ImageView
            android:id="@+id/btn_back_details"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Customize your nails."
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/fredoka_bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layout_top_bar"
        android:layout_above="@+id/btn_next_details"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <View android:layout_width="match_parent" android:layout_height="10dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select Preset Size" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3" android:layout_marginBottom="24dp">
                <Button android:id="@+id/btn_size_s" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Size S" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginEnd="6dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                <Button android:id="@+id/btn_size_m" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Size M" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginHorizontal="3dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                <Button android:id="@+id/btn_size_l" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Size L" android:textColor="@color/text_primary" android:backgroundTint="@color/background_card" android:textAllCaps="false" android:fontFamily="@font/poppins_medium" android:layout_marginLeft="6dp" app:cornerRadius="20dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
            </LinearLayout>

            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customize Per Finger (mm)" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_centerVertical="true"/>
                <TextView android:id="@+id/btn_show_guide" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="Lihat Panduan ↗" android:textColor="@color/lavender_dark" android:textSize="13sp" android:fontFamily="@font/poppins_bold" android:clickable="true"/>
            </RelativeLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_rounded" android:padding="16dp" android:layout_marginBottom="24dp" android:elevation="2dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thumb (Ibu Jari)" android:textColor="@color/text_primary" android:fontFamily="@font/poppins_medium" android:layout_centerVertical="true"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btn_minus_thumb" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                        <TextView android:id="@+id/tv_val_thumb" android:layout_width="50dp" android:layout_height="wrap_content" android:text="14" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:gravity="center"/>
                        <Button android:id="@+id/btn_plus_thumb" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Index (Telunjuk)" android:textColor="@color/text_primary" android:fontFamily="@font/poppins_medium" android:layout_centerVertical="true"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btn_minus_index" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                        <TextView android:id="@+id/tv_val_index" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:gravity="center"/>
                        <Button android:id="@+id/btn_plus_index" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Middle (Tengah)" android:textColor="@color/text_primary" android:fontFamily="@font/poppins_medium" android:layout_centerVertical="true"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btn_minus_middle" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                        <TextView android:id="@+id/tv_val_middle" android:layout_width="50dp" android:layout_height="wrap_content" android:text="11" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:gravity="center"/>
                        <Button android:id="@+id/btn_plus_middle" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ring (Manis)" android:textColor="@color/text_primary" android:fontFamily="@font/poppins_medium" android:layout_centerVertical="true"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btn_minus_ring" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                        <TextView android:id="@+id/tv_val_ring" android:layout_width="50dp" android:layout_height="wrap_content" android:text="10" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:gravity="center"/>
                        <Button android:id="@+id/btn_plus_ring" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pinky (Kelingking)" android:textColor="@color/text_primary" android:fontFamily="@font/poppins_medium" android:layout_centerVertical="true"/>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_alignParentEnd="true" android:gravity="center_vertical" android:orientation="horizontal">
                        <Button android:id="@+id/btn_minus_pinky" android:layout_width="36dp" android:layout_height="36dp" android:text="-" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                        <TextView android:id="@+id/tv_val_pinky" android:layout_width="50dp" android:layout_height="wrap_content" android:text="8" android:textColor="@color/text_primary" android:textSize="16sp" android:fontFamily="@font/poppins_bold" android:gravity="center"/>
                        <Button android:id="@+id/btn_plus_pinky" android:layout_width="36dp" android:layout_height="36dp" android:text="+" android:textSize="16sp" android:textColor="@color/lavender_dark" android:backgroundTint="@color/background_card" android:padding="0dp" app:cornerRadius="18dp" app:strokeWidth="1dp" app:strokeColor="@color/divider"/>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Special Custom Request Notes" android:textColor="@color/text_primary" android:textSize="15sp" android:fontFamily="@font/poppins_bold" android:layout_marginBottom="12dp"/>
            <EditText
                android:id="@+id/et_special_notes"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_card_rounded"
                android:gravity="top|left"
                android:padding="14dp"
                android:hint="Contoh: Tambahkan inisial huruf 'D' di kuku jari manis..."
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:layout_marginBottom="20dp"
                android:elevation="2dp"/>

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_next_details"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="Next to Review"
        android:textColor="@color/white"
        android:backgroundTint="@color/lavender_dark"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        app:cornerRadius="28dp"
        android:elevation="4dp" />

</RelativeLayout>